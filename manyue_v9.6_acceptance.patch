+/** Tracks one cancellable job per page and generation while serializing full-resolution loads. */
+internal class ManyuePrefetchJobCoordinator(private val scope: CoroutineScope) {
+    private data class JobKey(val chapterId: Long, val pageIndex: Int, val generation: Long)
+
+    private val jobs = ConcurrentHashMap<JobKey, Job>()
+    // Avoid keeping multiple full-resolution page buffers live at the same time.
+    private val loadMutex = Mutex()
+    @Volatile private var activeWindow: Pair<Long, Long>? = null
+
+    fun reconcile(
+        chapterId: Long,
+        currentPageIndex: Int,
+        generation: Long,
+        plan: List<ManyueAiSafetyPolicy.PrefetchTarget>,
+        work: suspend (ManyueAiSafetyPolicy.PrefetchTarget, Long) -> Unit,
+    ) {
+        val desired = plan.asSequence()
+            .filter { it.pageIndex != currentPageIndex }
+            .associateBy { JobKey(chapterId, it.pageIndex, generation) }
+        val toStart = mutableListOf<Job>()
+        synchronized(this) {
+            activeWindow = chapterId to generation
+            jobs.keys.filter { it !in desired.keys }.forEach { key -> jobs.remove(key)?.cancel() }
+            desired.forEach { (key, target) ->
+                if (jobs.containsKey(key)) return@forEach
+                val job = scope.launch(start = CoroutineStart.LAZY) {
+                    try {
+                        loadMutex.withLock {
+                            ensureCurrent(chapterId, generation)
+                            work(target, generation)
+                        }
+                    } catch (error: Throwable) {
+                        if (error is CancellationException) throw error
+                        logcat { "Manyue prefetch failed page=${target.pageIndex}: ${error.javaClass.simpleName}" }
+                    } finally {
+                        currentCoroutineContext()[Job]?.let { jobs.remove(key, it) }
+                    }
+                }
+                val existing = jobs.putIfAbsent(key, job)
+                if (existing == null) toStart += job else job.cancel()
+            }
+        }
+        toStart.forEach(Job::start)
+    }
+
+    suspend fun ensureCurrent(chapterId: Long, generation: Long) {
+        currentCoroutineContext().ensureActive()
+        if (!isCurrent(chapterId, generation)) {
+            throw CancellationException("Stale Manyue prefetch generation")
+        }
+    }
+
+    fun isCurrent(chapterId: Long, generation: Long): Boolean =
+        activeWindow == (chapterId to generation)
+
+    fun cancelAll() {
+        synchronized(this) {
+            activeWindow = null
+            jobs.values.forEach(Job::cancel)
+            jobs.clear()
+        }
+    }
+}
 
