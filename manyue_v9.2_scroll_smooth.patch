+    private suspend fun awaitDisplayPause(
+        expectedToken: String,
+        expectedIdentity: Identity,
+        expectedMode: Int,
+        expectedGeneration: Long,
+    ): Boolean {
+        val recycler = findRecyclerView() ?: return isCurrent(
+            expectedToken, expectedIdentity, expectedMode, expectedGeneration,
+        )
+        var quietSince = 0L
+        while (isCurrent(expectedToken, expectedIdentity, expectedMode, expectedGeneration)) {
+            if (!view.isAttachedToWindow) return false
+            val pageVisible = view.isShown && view.getGlobalVisibleRect(Rect())
+            val settled = pageVisible && recycler.scrollState == RecyclerView.SCROLL_STATE_IDLE &&
+                !recycler.isComputingLayout
+            val now = SystemClock.uptimeMillis()
+            if (settled) {
+                if (quietSince == 0L) quietSince = now
+                if (now - quietSince >= SCROLL_SETTLE_MS) return true
+            } else {
+                quietSince = 0L
+            }
+            delay(80L)
+        }
+        return false
+    }
+
+    private fun findRecyclerView(): RecyclerView? {
+        var ancestor = view.parent
+        while (ancestor != null) {
+            if (ancestor is RecyclerView) return ancestor
+            ancestor = (ancestor as? View)?.parent
+        }
+        return null
