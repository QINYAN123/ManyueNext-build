+        @Override
+        protected void onPostExecute(Bitmap bitmap) {
+            final SubsamplingScaleImageView subsamplingScaleImageView = viewRef.get();
+            final ImageRegionDecoder decoder = decoderRef.get();
+            final Tile tile = tileRef.get();
+            boolean current = subsamplingScaleImageView != null && decoder != null && tile != null
+                && decoder == subsamplingScaleImageView.decoder
+                && imageGeneration == subsamplingScaleImageView.imageGeneration
+                && tile.visible
+                && subsamplingScaleImageView.containsTile(tile);
+            if (tile != null) {
+                tile.loading = false;
+            }
+            if (current) {
+                if (bitmap != null) {
+                    tile.bitmap = bitmap;
+                    bitmap = null;
+                    subsamplingScaleImageView.onTileLoaded();
+                } else if (exception != null && subsamplingScaleImageView.onImageEventListener != null) {
+                    subsamplingScaleImageView.onImageEventListener.onTileLoadError(exception);
+                }
