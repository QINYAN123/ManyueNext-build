@@ -0,0 +1,25 @@
+package eu.kanade.tachiyomi.ui.reader.manyue
+
+/** Do not launch another GPU inference while the strip reader is handling a gesture/fling. */
+object ManyueReaderWorkGate {
+    @Volatile private var owner: Any? = null
+    @Volatile private var busy = false
+    @Volatile private var quietAfterNanos = 0L
+
+    @Synchronized
+    fun update(reader: Any, active: Boolean) {
+        owner = reader
+        busy = active
+        quietAfterNanos = System.nanoTime() + 300_000_000L
+    }
+
+    @Synchronized
+    fun release(reader: Any) {
+        if (owner !== reader) return
+        owner = null
+        busy = false
+        quietAfterNanos = 0L
+    }
+
+    fun isBlocked(): Boolean = busy || System.nanoTime() < quietAfterNanos
+}
