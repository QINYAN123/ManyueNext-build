+    @SuppressWarnings("SuspiciousNameCombination")
+    private int getEffectiveSWidth() {
+        ImageRotation rotation = getImageRotation();
+        if (rotation == ImageRotation.ROTATION_90 || rotation == ImageRotation.ROTATION_270) {
+            return sHeight;
+        } else {
