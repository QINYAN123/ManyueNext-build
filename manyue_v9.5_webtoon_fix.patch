+    /**
+     * Async task used to get image details without blocking the UI thread.
+     */
+    private static class TilesInitTask extends AsyncTask<Void, Void, int[]> {
+        private final WeakReference<SubsamplingScaleImageView> viewRef;
+        private final WeakReference<Context> contextRef;
+        private final WeakReference<InputProvider> providerRef;
+        private final long imageGeneration;
+        private final Rect sourceRegion;
+        private final boolean cropBorders;
+        private final ImageRegionDecoderFactory regionDecoderFactory;
+        private ImageRegionDecoder decoder;
+        private Exception exception;
+
+        TilesInitTask(
+            SubsamplingScaleImageView view,
+            Context context,
+            InputProvider provider,
+            long imageGeneration,
+            Rect sourceRegion,
+            boolean cropBorders,
+            ImageRegionDecoderFactory regionDecoderFactory) {
+            this.viewRef = new WeakReference<>(view);
+            this.contextRef = new WeakReference<>(context);
+            this.providerRef = new WeakReference<>(provider);
+            this.imageGeneration = imageGeneration;
+            this.sourceRegion = sourceRegion == null ? null : new Rect(sourceRegion);
+            this.cropBorders = cropBorders;
+            this.regionDecoderFactory = regionDecoderFactory;
+        }
+
+        @Override
+        protected int[] doInBackground(Void... params) {
+            try {
+                Context context = contextRef.get();
+                SubsamplingScaleImageView view = viewRef.get();
+                InputProvider provider = providerRef.get();
+                if (context != null && view != null && provider == view.provider && imageGeneration == view.imageGeneration) {
+                    view.debug("TilesInitTask.doInBackground");
+                    decoder = regionDecoderFactory == null ? new Decoder(cropBorders) : regionDecoderFactory.create();
+                    if (decoder == null) {
+                        throw new IllegalStateException("ImageRegionDecoderFactory returned null");
+                    }
+                    Point dimensions = decoder.init(context, provider);
+                    int sWidth = dimensions.x;
+                    int sHeight = dimensions.y;
+                    if (sourceRegion != null) {
+                        sourceRegion.left = Math.max(0, sourceRegion.left);
+                        sourceRegion.top = Math.max(0, sourceRegion.top);
+                        sourceRegion.right = Math.min(sWidth, sourceRegion.right);
+                        sourceRegion.bottom = Math.min(sHeight, sourceRegion.bottom);
+                        sWidth = sourceRegion.width();
+                        sHeight = sourceRegion.height();
+                    }
+                    return new int[]{sWidth, sHeight};
+                }
+            } catch (OutOfMemoryError e) {
+                Log.e(TAG, "Failed to initialise bitmap decoder", e);
+                this.exception = new RuntimeException("Failed to initialise bitmap decoder", e);
+                recycleDecoder();
+            } catch (Exception e) {
+                Log.e(TAG, "Failed to initialise bitmap decoder", e);
+                this.exception = e;
+                recycleDecoder();
+            }
+            return null;
+        }
+
+        @Override
+        protected void onPostExecute(int[] xy) {
+            final SubsamplingScaleImageView view = viewRef.get();
+            final InputProvider provider = providerRef.get();
+            try {
+                if (view != null && provider == view.provider && imageGeneration == view.imageGeneration) {
+                    if (decoder != null && xy != null && xy.length == 2) {
+                        if (sourceRegion != null && view.sRegion != null) {
+                            view.sRegion.set(sourceRegion);
+                        }
+                        view.onTilesInited(decoder, xy[0], xy[1]);
+                        decoder = null;
+                    } else if (exception != null && view.onImageEventListener != null) {
+                        view.onImageEventListener.onImageLoadError(exception);
+                    }
+                }
+            } finally {
+                recycleDecoder();
+            }
+        }
+
+        @Override
+        protected void onCancelled(int[] xy) {
+            recycleDecoder();
+        }
+
+        private void recycleDecoder() {
+            ImageRegionDecoder initializedDecoder = decoder;
+            decoder = null;
+            if (initializedDecoder != null) {
+                try {
+                    initializedDecoder.recycle();
+                } catch (Exception e) {
+                    Log.w(TAG, "Failed to recycle bitmap decoder", e);
+                }
+            }
+        }
+    }
