+
+            val waiter = async(start = CoroutineStart.UNDISPATCHED) {
+                ManyueEnhancementCache.awaitPrefetchBudget(
+                    context,
+                    other.mangaId,
+                    other.chapterId,
+                    other.pageIndex,
+                    estimatedBytes = 1L,
+                )
+            }
+            assertFalse(waiter.isCompleted)
