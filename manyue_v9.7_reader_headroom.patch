+
+/** Spaces expensive jobs without sleeping on the UI thread or changing image quality. */
+internal class ManyueWorkPacer(private val nanoTime: () -> Long = System::nanoTime) {
+    @Volatile private var readyAtNanos: Long? = null
+
+    fun isBlocked(): Boolean = readyAtNanos?.let { nanoTime() - it < 0L } ?: false
+
+    fun afterWork(startedAtNanos: Long) {
+        val now = nanoTime()
+        val elapsed = (now - startedAtNanos).coerceAtLeast(0L)
+        // Let the renderer and device catch up between pages. This is a scheduling gap,
+        // not a claimed percentage cap on a running native GPU kernel.
+        val rest = (elapsed / 2).coerceIn(500_000_000L, 2_000_000_000L)
+        readyAtNanos = now + rest
+    }
+}
