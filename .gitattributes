* text=auto
* text eol=lf

# Windows forced line-endings
/.idea/* text eol=crlf

# Gradle wrapper
*.jar binary
*.so binary
*.bin binary
*.pt binary
*.pth binary
*.f32 binary
*-chw-f32 binary
*.npy binary
*.npz binary
*.param -text whitespace=cr-at-eol

# The model metadata and audited training bundle have checksums over exact bytes.
app/src/main/assets/ai/models-Manyue-Lite/** -text whitespace=cr-at-eol
native/manyue-lite/training/** -text whitespace=cr-at-eol

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.swp binary
